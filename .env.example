# Project MIP: Institutional Configuration Template
# Copy this file to .env for local runtime execution (never commit .env to version control)

# Telegram Alert & Tearsheet Dispatcher (Optional)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890

# Database Immutability Controls
MIP_READONLY=1
MIP_ALLOW_PROD_MUTATION=0

# Google Drive Cloud Staging (Optional - for headless environments)
# Set the path to your Service Account JSON file (outside the repository or in secure storage)
# GDRIVE_SA_KEY_PATH=/path/to/secure/service_account.json
# Alternatively, set the Google Drive File ID for universe.db (if using public/shared link)
# GDRIVE_UNIVERSE_DB_FILE_ID=1_YourGoogleDriveFileIdHere
