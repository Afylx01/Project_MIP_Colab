data/universe.db
data/universe.db-wal
data/universe.db-shm
data/universe.db.bak
data/*.db
data/universe.db.pre_repair_*
data/universe.db.bak
data/*.sqlite
data/*.sqlite3

# C99 Compiled Shared Libraries & Binary Objects
*.so
*.o
*.dylib
*.dll
*.a
mip_sim_kernel.so

